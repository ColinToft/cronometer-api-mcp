CRONOMETER_USERNAME=
CRONOMETER_PASSWORD=
# Only for accounts with two-factor authentication: the base32 key shown at 2FA setup
CRONOMETER_TOTP_SECRET=
# Optional IANA timezone override, for example America/Los_Angeles
CRONOMETER_ACCOUNT_TZ=
# Optional diary group names for groups 1, 2, 3, ... in order. Leave commented
# out for the default; an empty value is refused.
# CRONOMETER_DIARY_GROUPS=breakfast,lunch,dinner,snacks
